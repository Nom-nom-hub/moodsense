{
  "activationEvents": [
    "onStartupFinished",
    "onView:moodsense.panel",
    "onWalkthrough:moodsense.gettingStarted"
  ],
  "categories": [
    "Other",
    "Themes"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moodsense.pickMood",
        "title": "MoodSense: Set Mood\u2026"
      },
      {
        "command": "moodsense.setFocused",
        "title": "MoodSense: Focused"
      },
      {
        "command": "moodsense.setRelaxed",
        "title": "MoodSense: Relaxed"
      },
      {
        "command": "moodsense.setTired",
        "title": "MoodSense: Tired"
      },
      {
        "command": "moodsense.setEnergetic",
        "title": "MoodSense: Energetic"
      },
      {
        "command": "moodsense.off",
        "title": "MoodSense: Off (Restore My Setup)"
      },
      {
        "command": "moodsense.focusMode",
        "title": "MoodSense: Focus Mode"
      },
      {
        "command": "moodsense.openAmbient",
        "title": "MoodSense: Open Control Panel"
      },
      {
        "command": "moodsense.stopAmbient",
        "title": "MoodSense: Stop Ambient Sound"
      },
      {
        "command": "moodsense.resetBreakTimer",
        "title": "MoodSense: Reset Break Timer"
      },
      {
        "command": "moodsense.exportMoods",
        "title": "MoodSense: Export Moods (JSON to Clipboard)"
      },
      {
        "command": "moodsense.importMoods",
        "title": "MoodSense: Import Moods (Paste JSON)"
      },
      {
        "command": "moodsense.resetMoods",
        "title": "MoodSense: Reset Moods to Defaults"
      },
      {
        "command": "moodsense.cycleMood",
        "title": "MoodSense: Cycle Mood"
      },
      {
        "command": "moodsense.clearHistory",
        "title": "MoodSense: Clear Mood History"
      }
    ],
    "configuration": {
      "properties": {
        "moodsense.ambient.volume": {
          "default": 0.7,
          "description": "Ambient player volume (0\u20131).",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "moodsense.applyLayoutChanges": {
          "default": false,
          "description": "Let moods change layout (Zen mode, minimap). Off by default: MoodSense adapts theme, font, and sound automatically, but never rearranges your workspace unless you allow it or invoke Focus Mode.",
          "type": "boolean"
        },
        "moodsense.breaks.enabled": {
          "default": true,
          "description": "Enable break reminders while MoodSense is active.",
          "type": "boolean"
        },
        "moodsense.breaks.intervalMinutes": {
          "default": 50,
          "description": "Minutes between break reminders (before the mood's multiplier is applied).",
          "type": "number"
        },
        "moodsense.profiles": {
          "default": {
            "energetic": {
              "ambient": "wind",
              "icon": "bolt",
              "accent": "#FBBF24",
              "breakIntervalMultiplier": 1.2,
              "fontSize": 13,
              "label": "Energetic",
              "minimap": true,
              "theme": "Monokai",
              "zen": false
            },
            "focused": {
              "ambient": "deep",
              "icon": "target",
              "accent": "#7C8CF8",
              "breakIntervalMultiplier": 1,
              "fontSize": 14,
              "label": "Focused",
              "minimap": false,
              "theme": "Default Dark Modern",
              "zen": true
            },
            "relaxed": {
              "ambient": "rain",
              "icon": "leaf",
              "accent": "#4ADE80",
              "breakIntervalMultiplier": 1,
              "fontSize": 14,
              "label": "Relaxed",
              "minimap": true,
              "theme": "Quiet Light",
              "zen": false
            },
            "tired": {
              "ambient": "rain",
              "icon": "moon",
              "accent": "#A78BFA",
              "breakIntervalMultiplier": 0.6,
              "fontSize": 16,
              "label": "Tired",
              "minimap": true,
              "theme": "Default Dark Modern",
              "zen": false
            }
          },
          "description": "Mood profiles. Each mood maps to an icon (target | leaf | moon | bolt), an accent color, a theme, font size, and optional font family, line height, and cursor style \u2014 plus Zen preference, minimap, ambient track (deep | rain | wind | none), and a break-interval multiplier. Edit them visually in the MoodSense panel, or add your own moods by adding keys here.",
          "type": "object"
        },
        "moodsense.ambient.customDirectory": {
          "type": "string",
          "default": "",
          "description": "Folder with your own ambient audio files (.ogg, .mp3, .wav, .m4a, .flac). Files found there appear in the panel under \"Your audio\" and can be assigned to moods. Leave empty to use only the built-in soundscapes."
        },
        "moodsense.schedule.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch moods by time of day (see moodsense.schedule). A mood is applied when a time boundary is crossed; a manual choice mid-window stands until the next boundary."
        },
        "moodsense.schedule": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "description": "\"HH:MM\" 24-hour start of the window"
              },
              "mood": {
                "type": "string",
                "description": "Mood id to apply"
              }
            },
            "required": [
              "start",
              "mood"
            ]
          },
          "description": "Time windows for automatic mood switching, e.g. [{\"start\":\"09:00\",\"mood\":\"energetic\"},{\"start\":\"18:00\",\"mood\":\"tired\"}]. The last window wraps into the next morning."
        },
        "moodsense.quietHours": {
          "type": "object",
          "default": {
            "enabled": false,
            "start": "22:00",
            "end": "07:00"
          },
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "string",
              "description": "\"HH:MM\""
            },
            "end": {
              "type": "string",
              "description": "\"HH:MM\" (may wrap past midnight)"
            }
          },
          "description": "During quiet hours, ambient sound is muted and break reminders wait until the window ends."
        },
        "moodsense.pomodoro.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run the timer as a Pomodoro cycle: focus blocks and breaks alternate, and the soundscape pauses during breaks."
        },
        "moodsense.pomodoro.workMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Pomodoro focus block length in minutes (the mood break multiplier still applies)."
        },
        "moodsense.pomodoro.breakMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Pomodoro break length in minutes."
        },
        "moodsense.routines": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mood": {
                "type": "string"
              },
              "focusMode": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "mood"
            ]
          },
          "description": "One-click routines shown in the panel, e.g. [{\"name\":\"Good morning\",\"mood\":\"energetic\"},{\"name\":\"Deep work\",\"mood\":\"focused\",\"focusMode\":true}]."
        }
      },
      "title": "MoodSense"
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moodsense",
          "title": "MoodSense",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "moodsense": [
        {
          "type": "webview",
          "id": "moodsense.panel",
          "name": "Control Panel"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "moodsense.gettingStarted",
        "title": "Get started with MoodSense",
        "description": "Set your first mood and make the IDE yours.",
        "steps": [
          {
            "id": "pick-first-mood",
            "title": "Pick your first mood",
            "description": "MoodSense reshapes your theme, font, and soundscape around how you are working.\n[Set a mood](command:moodsense.pickMood)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "MoodSense mood orbs"
            }
          },
          {
            "id": "panel",
            "title": "Meet the control panel",
            "description": "The MoodSense icon in the Activity Bar opens your control panel: mood cards, ambient sound, and your break countdown in one place.\n[Open the panel](command:moodsense.panel.focus)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "MoodSense control panel"
            }
          },
          {
            "id": "your-setup-is-safe",
            "title": "Your setup is safe",
            "description": "Before MoodSense changes anything, it snapshots your theme, font, and minimap. Turning MoodSense off restores them exactly \u2014 and layout changes (Zen, minimap) never happen unless you opt in or invoke Focus Mode.\n[Turn MoodSense off](command:moodsense.off)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "Snapshot and restore"
            }
          },
          {
            "id": "make-it-yours",
            "title": "Make it yours",
            "description": "Every mood is a profile in settings: theme, font size, ambient track, break rhythm. Edit them, or invent moods of your own.\n[Open settings](command:workbench.action.openSettings?%5B%22moodsense.profiles%22%5D)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "Mood profiles in settings"
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "moodsense.cycleMood",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ]
  },
  "description": "Pick your mood; your IDE reshapes itself around it. Theme, font, ambient sound, and focus level adapt to how you work \u2014 100% local, no telemetry, no accounts.",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.0"
  },
  "displayName": "MoodSense \u2014 Mood-Adaptive IDE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "mood",
    "focus",
    "ambient",
    "theme",
    "wellbeing",
    "productivity"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "moodsense",
  "publisher": "nom-nom-hub",
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "version": "0.5.0",
  "icon": "media/icon.png"
}
