{
  "activationEvents": [
    "onStartupFinished",
    "onView:moodsense.panel",
    "onWalkthrough:moodsense.gettingStarted"
  ],
  "categories": [
    "Other",
    "Themes"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moodsense.pickMood",
        "title": "MoodSense: Set Mood\u2026"
      },
      {
        "command": "moodsense.setFocused",
        "title": "MoodSense: Focused"
      },
      {
        "command": "moodsense.setRelaxed",
        "title": "MoodSense: Relaxed"
      },
      {
        "command": "moodsense.setTired",
        "title": "MoodSense: Tired"
      },
      {
        "command": "moodsense.setEnergetic",
        "title": "MoodSense: Energetic"
      },
      {
        "command": "moodsense.off",
        "title": "MoodSense: Off (Restore My Setup)"
      },
      {
        "command": "moodsense.focusMode",
        "title": "MoodSense: Focus Mode"
      },
      {
        "command": "moodsense.openAmbient",
        "title": "MoodSense: Open Control Panel"
      },
      {
        "command": "moodsense.stopAmbient",
        "title": "MoodSense: Stop Ambient Sound"
      },
      {
        "command": "moodsense.resetBreakTimer",
        "title": "MoodSense: Reset Break Timer"
      }
    ],
    "configuration": {
      "properties": {
        "moodsense.ambient.volume": {
          "default": 0.7,
          "description": "Ambient player volume (0\u20131).",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "moodsense.applyLayoutChanges": {
          "default": false,
          "description": "Let moods change layout (Zen mode, minimap). Off by default: MoodSense adapts theme, font, and sound automatically, but never rearranges your workspace unless you allow it or invoke Focus Mode.",
          "type": "boolean"
        },
        "moodsense.breaks.enabled": {
          "default": true,
          "description": "Enable break reminders while MoodSense is active.",
          "type": "boolean"
        },
        "moodsense.breaks.intervalMinutes": {
          "default": 50,
          "description": "Minutes between break reminders (before the mood's multiplier is applied).",
          "type": "number"
        },
        "moodsense.profiles": {
          "default": {
            "energetic": {
              "ambient": "wind",
              "breakIntervalMultiplier": 1.2,
              "emoji": "\u26a1",
              "fontSize": 13,
              "label": "Energetic",
              "minimap": true,
              "theme": "Monokai",
              "zen": false
            },
            "focused": {
              "ambient": "deep",
              "breakIntervalMultiplier": 1,
              "emoji": "\ud83c\udfaf",
              "fontSize": 14,
              "label": "Focused",
              "minimap": false,
              "theme": "Default Dark Modern",
              "zen": true
            },
            "relaxed": {
              "ambient": "rain",
              "breakIntervalMultiplier": 1,
              "emoji": "\ud83c\udf3f",
              "fontSize": 14,
              "label": "Relaxed",
              "minimap": true,
              "theme": "Quiet Light",
              "zen": false
            },
            "tired": {
              "ambient": "rain",
              "breakIntervalMultiplier": 0.6,
              "emoji": "\ud83c\udf19",
              "fontSize": 16,
              "label": "Tired",
              "minimap": true,
              "theme": "Default Dark Modern",
              "zen": false
            }
          },
          "description": "Mood profiles. Each mood maps to a theme, font size, Zen preference, minimap, ambient track (deep | rain | wind | none), and a break-interval multiplier. Add your own moods by adding keys.",
          "type": "object"
        }
      },
      "title": "MoodSense"
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moodsense",
          "title": "MoodSense",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "moodsense": [
        {
          "type": "webview",
          "id": "moodsense.panel",
          "name": "Control Panel"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "moodsense.gettingStarted",
        "title": "Get started with MoodSense",
        "description": "Set your first mood and make the IDE yours.",
        "steps": [
          {
            "id": "pick-first-mood",
            "title": "Pick your first mood",
            "description": "MoodSense reshapes your theme, font, and soundscape around how you are working.\n[Set a mood](command:moodsense.pickMood)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "MoodSense mood orbs"
            }
          },
          {
            "id": "panel",
            "title": "Meet the control panel",
            "description": "The MoodSense icon in the Activity Bar opens your control panel: mood cards, ambient sound, and your break countdown in one place.\n[Open the panel](command:moodsense.panel.focus)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "MoodSense control panel"
            }
          },
          {
            "id": "your-setup-is-safe",
            "title": "Your setup is safe",
            "description": "Before MoodSense changes anything, it snapshots your theme, font, and minimap. Turning MoodSense off restores them exactly \u2014 and layout changes (Zen, minimap) never happen unless you opt in or invoke Focus Mode.\n[Turn MoodSense off](command:moodsense.off)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "Snapshot and restore"
            }
          },
          {
            "id": "make-it-yours",
            "title": "Make it yours",
            "description": "Every mood is a profile in settings: theme, font size, ambient track, break rhythm. Edit them, or invent moods of your own.\n[Open settings](command:workbench.action.openSettings?%5B%22moodsense.profiles%22%5D)",
            "media": {
              "image": "media/walkthrough.svg",
              "altText": "Mood profiles in settings"
            }
          }
        ]
      }
    ]
  },
  "description": "Pick your mood; your IDE reshapes itself around it. Theme, font, ambient sound, and focus level adapt to how you work \u2014 100% local, no telemetry, no accounts.",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.0"
  },
  "displayName": "MoodSense \u2014 Mood-Adaptive IDE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "mood",
    "focus",
    "ambient",
    "theme",
    "wellbeing",
    "productivity"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "moodsense",
  "publisher": "nom-nom-hub",
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "version": "0.2.0",
  "icon": "media/icon.png"
}
